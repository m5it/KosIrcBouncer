#!/bin/bash
# Example hook - triggered when someone is opped (+o)
# Available: IRC_NETWORK, IRC_SERVER, IRC_EVENT, IRC_CHANNEL, IRC_NICK, IRC_IDENT, IRC_HOST, IRC_TARGET, IRC_MODE, IRC_RAW
# Positional: $1=network $2=event $3=channel $4=nick $5=target $6=text

echo "OP: $IRC_NICK gave +o to $IRC_TARGET in $IRC_CHANNEL on $IRC_NETWORK" >> /tmp/bnc.log
