[Unit]
Description=IRC BNC Service
Documentation=https://github.com/yourusername/irc-bnc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ircbnc
Group=ircbnc
WorkingDirectory=/opt/irc-bnc
Environment=PYTHONUNBUFFERED=1
Environment=BNC_DATA_DIR=/var/lib/irc-bnc

ExecStart=/usr/bin/python3 -m irc_bnc.main --config /etc/irc-bnc/config.json
ExecReload=/bin/kill -HUP $MAINPID

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/irc-bnc /var/log/irc-bnc

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=irc-bnc

[Install]
WantedBy=multi-user.target